{
	"name": "antigravity-native-accept",
	"displayName": "Antigravity Auto Accept (Native · No CDP)",
	"description": "Auto-accept Google Antigravity edits in VS Code via native commands — no CDP, no --remote-debugging-port, 65 lines of auditable MIT JS.",
	"version": "0.1.5",
	"publisher": "jeinn-co",
	"author": {
		"name": "Zevi Liao",
		"url": "https://www.jeinn.co"
	},
	"license": "MIT",
	"icon": "icon.png",
	"repository": {
		"type": "git",
		"url": "https://github.com/Jeinn-co/antigravity-native-accept.git"
	},
	"homepage": "https://github.com/Jeinn-co/antigravity-native-accept#readme",
	"bugs": {
		"url": "https://github.com/Jeinn-co/antigravity-native-accept/issues"
	},
	"engines": {
		"vscode": "^1.80.0"
	},
	"categories": [
		"Machine Learning",
		"Other"
	],
	"keywords": [
		"antigravity",
		"auto accept",
		"auto-accept",
		"google antigravity",
		"no cdp",
		"native",
		"diff",
		"ai",
		"agent"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./extension.js",
	"contributes": {
		"commands": [
			{
				"command": "antigravityNativeAccept.toggle",
				"title": "Antigravity Native Accept: Toggle ON/OFF"
			}
		],
		"keybindings": [
			{
				"command": "antigravityNativeAccept.toggle",
				"key": "ctrl+shift+a",
				"mac": "cmd+shift+a"
			}
		]
	}
}
